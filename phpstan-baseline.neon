parameters:
	ignoreErrors:
		-
			message: '#^Class Schwendinger\\Webtrees\\Module\\LinkEnhancer\\CommonMark\\LeImageRenderer has an uninitialized @readonly property \$config\. Assign it in the constructor\.$#'
			identifier: property.uninitializedReadonlyByPhpDoc
			count: 1
			path: src/CommonMark/LeImageRenderer.php

		-
			message: '#^Method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\CommonMark\\LeTableOfContentsRenderer\:\:__construct\(\) has parameter \$config with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/CommonMark/LeTableOfContentsRenderer.php

		-
			message: '#^Method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\DataFix\\Handlers\\XrefUidSwapFix\:\:selectedRectypes\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/DataFix/Handlers/XrefUidSwapFix.php

		-
			message: '#^Offset ''end'' does not exist on array\{value\: string, is_le\: bool\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/DataFix/Handlers/XrefUidSwapFix.php

		-
			message: '#^Offset ''start'' does not exist on array\{value\: string, is_le\: bool\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/DataFix/Handlers/XrefUidSwapFix.php

		-
			message: '#^Method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Http\\RequestHandlers\\GotoUidAction\:\:visibleRecords\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Http/RequestHandlers/GotoUidAction.php

		-
			message: '#^Variable \$setting on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: src/LinkEnhancerModule.php

		-
			message: '#^Call to an undefined method Fisharebest\\Webtrees\\Module\\AbstractModule\:\:assetUrl\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/LinkEnhancerUtils.php

		-
			message: '#^Parameter &\$row by\-ref type of method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Schema\\SeedHelpTable\:\:setRowDefaults\(\) expects array\<string, string\|null\>, array\<string, int\|string\|null\> given\.$#'
			identifier: parameterByRef.type
			count: 1
			path: src/Schema/SeedHelpTable.php

		-
			message: '#^Strict comparison using \!\=\= between non\-empty\-list and array\{\} will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Services/LinkRenderer.php

		-
			message: '#^Left side of && is always false\.$#'
			identifier: booleanAnd.leftAlwaysFalse
			count: 1
			path: src/Services/TextTagCollector.php

		-
			message: '#^Strict comparison using \!\=\= between null and null will always evaluate to false\.$#'
			identifier: notIdentical.alwaysFalse
			count: 1
			path: src/Services/TextTagCollector.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Query\\Builder\:\:toRawSqlSafe\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Services/WthbService.php

		-
			message: '#^PHPDoc tag @var with type string is not subtype of native type Fisharebest\\Webtrees\\Module\\ModuleInterface\|null\.$#'
			identifier: varTag.nativeType
			count: 1
			path: src/Services/WthbService.php

		-
			message: '#^Parameter \#1 \$data of class Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Schema\\SeedHelpTable constructor expects array\<int, array\<string, string\|null\>\>, list\<array\<string, array\|string\>\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Services/WthbService.php

		-
			message: '#^Result of method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Services\\WthbService\:\:importCsvFlash\(\) \(void\) is used\.$#'
			identifier: method.void
			count: 1
			path: src/Services/WthbService.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Services/WthbTocService.php

		-
			message: '#^Method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Services\\XrefOverviewColumns\:\:blockRowToColumns\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Services/XrefOverviewColumns.php

		-
			message: '#^Method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Services\\XrefOverviewColumns\:\:inventoryColumns\(\) has parameter \$inventory with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Services/XrefOverviewColumns.php

		-
			message: '#^Method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Services\\XrefOverviewColumns\:\:resolveTarget\(\) should return array\{name\: string, url\: string, tree_label\: string, actual\: string\}\|null but returns string\|null\.$#'
			identifier: return.type
			count: 1
			path: src/Services/XrefOverviewColumns.php

		-
			message: '#^PHPDoc tag @return with type \(callable\)\|null is not subtype of native type callable\.$#'
			identifier: return.phpDocType
			count: 1
			path: src/Services/XrefOverviewColumns.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Services/XrefOverviewColumns.php

		-
			message: '#^Variable \$url on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: src/Services/XrefOverviewColumns.php
