parameters:
	ignoreErrors:
		-
			message: '#^Class Schwendinger\\Webtrees\\Module\\LinkEnhancer\\CommonMark\\LeImageRenderer has an uninitialized @readonly property \$config\. Assign it in the constructor\.$#'
			identifier: property.uninitializedReadonlyByPhpDoc
			count: 1
			path: src/CommonMark/LeImageRenderer.php

		-
			message: '#^Variable \$attr on left side of \?\? is never defined\.$#'
			identifier: nullCoalesce.variable
			count: 2
			path: src/CommonMark/LeImageRenderer.php

		-
			message: '#^Method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\CommonMark\\LeTableOfContentsRenderer\:\:__construct\(\) has parameter \$config with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/CommonMark/LeTableOfContentsRenderer.php

		-
			message: '#^Method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\DataFix\\Handlers\\XrefUidSwapFix\:\:selectedRectypes\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/DataFix/Handlers/XrefUidSwapFix.php

		-
			message: '#^Offset ''end'' does not exist on array\{value\: string, is_le\: bool\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/DataFix/Handlers/XrefUidSwapFix.php

		-
			message: '#^Offset ''start'' does not exist on array\{value\: string, is_le\: bool\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/DataFix/Handlers/XrefUidSwapFix.php

		-
			message: '#^Call to function method_exists\(\) with Fisharebest\\Webtrees\\GedcomRecord and ''fullName'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Http/RequestHandlers/AbstractGotoAction.php

		-
			message: '#^Method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Http\\RequestHandlers\\GotoUidAction\:\:visibleRecords\(\) has parameter \$hits with generic class Illuminate\\Support\\Collection but does not specify its types\: TKey, TValue$#'
			identifier: missingType.generics
			count: 1
			path: src/Http/RequestHandlers/GotoUidAction.php

		-
			message: '#^Match arm comparison between ''int'' and ''int'' is always true\.$#'
			identifier: match.alwaysTrue
			count: 1
			path: src/LinkEnhancerModule.php

		-
			message: '#^Match arm comparison between Schwendinger\\Webtrees\\Module\\LinkEnhancer\\OverwriteMode\:\:ParentIsNotOne and Schwendinger\\Webtrees\\Module\\LinkEnhancer\\OverwriteMode\:\:ParentIsNotOne is always true\.$#'
			identifier: match.alwaysTrue
			count: 1
			path: src/LinkEnhancerModule.php

		-
			message: '#^Offset ''type'' on array\{type\: ''bool'', default\: ''1'', parent\: ''MD_ACTIVE''\|''MD_EXT_ACTIVE''\|''WTHB_LINK_ACTIVE''\|''WTHB_TOCNSEARCH'', mode\: Schwendinger\\Webtrees\\Module\\LinkEnhancer\\OverwriteMode\:\:ParentIsZero\}\|array\{type\: ''bool'', default\: ''1'', parent\: ''OPEN_IN_NEW_TAB'', mode\: Schwendinger\\Webtrees\\Module\\LinkEnhancer\\OverwriteMode\:\:ParentIsNotOne\}\|array\{type\: ''bool''\|''int'', default\: ''0''\|''1''\|''10000''\|''2''\}\|array\{type\: ''int'', default\: ''2'', parent\: ''MD_EXT_ACTIVE'', mode\: Schwendinger\\Webtrees\\Module\\LinkEnhancer\\OverwriteMode\:\:ParentIsZero\}\|array\{type\: ''string'', default\?\: ''''\|''\#''\|"\[\\n\{\\"title\\"\:…"\|''\[TOC\]''\|''all''\|''dropdown''\|''https\://wiki…''\|''md\-img''\|''md\-img\-title''\|''none''\|''relative''\|''↩''\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/LinkEnhancerModule.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: src/LinkEnhancerModule.php

		-
			message: '#^Strict comparison using \=\=\= between non\-empty\-string and '''' will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/LinkEnhancerModule.php

		-
			message: '#^Variable \$setting on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: src/LinkEnhancerModule.php

		-
			message: '#^Call to an undefined method Fisharebest\\Webtrees\\Module\\AbstractModule\:\:assetUrl\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/LinkEnhancerUtils.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/LinkEnhancerUtils.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 2
			path: src/Schema/SeedHelpTable.php

		-
			message: '#^Loose comparison using \=\= between '''' and '''' will always evaluate to true\.$#'
			identifier: equal.alwaysTrue
			count: 3
			path: src/Schema/SeedHelpTable.php

		-
			message: '#^Offset ''handler'' on non\-empty\-array on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Schema/SeedHelpTable.php

		-
			message: '#^Offset ''path'' on non\-empty\-array on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Schema/SeedHelpTable.php

		-
			message: '#^Parameter &\$row by\-ref type of method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Schema\\SeedHelpTable\:\:setRowDefaults\(\) expects array\<string, string\|null\>, array\<string, int\|string\|null\> given\.$#'
			identifier: parameterByRef.type
			count: 1
			path: src/Schema/SeedHelpTable.php

		-
			message: '#^Result of \|\| is always true\.$#'
			identifier: booleanOr.alwaysTrue
			count: 2
			path: src/Schema/SeedHelpTable.php

		-
			message: '#^Variable \$category on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: src/Schema/SeedHelpTable.php

		-
			message: '#^Strict comparison using \!\=\= between non\-empty\-list and array\{\} will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Services/LinkRenderer.php

		-
			message: '#^Left side of && is always false\.$#'
			identifier: booleanAnd.leftAlwaysFalse
			count: 1
			path: src/Services/TextTagCollector.php

		-
			message: '#^Strict comparison using \!\=\= between null and null will always evaluate to false\.$#'
			identifier: notIdentical.alwaysFalse
			count: 1
			path: src/Services/TextTagCollector.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Query\\Builder\:\:toRawSqlSafe\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Services/WthbService.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Services/WthbService.php

		-
			message: '#^PHPDoc tag @var with type string is not subtype of native type Fisharebest\\Webtrees\\Module\\ModuleInterface\|null\.$#'
			identifier: varTag.nativeType
			count: 1
			path: src/Services/WthbService.php

		-
			message: '#^Parameter \#1 \$data of class Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Schema\\SeedHelpTable constructor expects array\<int, array\<string, string\|null\>\>, list\<array\<string, array\|string\>\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Services/WthbService.php

		-
			message: '#^Result of method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Services\\WthbService\:\:importCsvFlash\(\) \(void\) is used\.$#'
			identifier: method.void
			count: 1
			path: src/Services/WthbService.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Services/WthbTocService.php

		-
			message: '#^Instanceof between Fisharebest\\Webtrees\\GedcomRecord and Fisharebest\\Webtrees\\GedcomRecord will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 3
			path: src/Services/XrefOverviewColumns.php

		-
			message: '#^Method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Services\\XrefOverviewColumns\:\:blockRowToColumns\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
