			identifier: missingType.iterableValue
			count: 1
			path: src/Services/XrefOverviewColumns.php

		-
			message: '#^Method Schwendinger\\Webtrees\\Module\\LinkEnhancer\\Services\\XrefOverviewColumns\:\:resolveTarget\(\) should return array\{name\: string, url\: string, tree_label\: string, actual\: string\}\|null but returns string\|null\.$#'
