#. I18N: Module title
msgid "Link-Enhancer"
msgstr "Расширение ссылок"

#. I18N: Module description
msgid ""
"Cross-references to Gedcom datasets, Markdown editor, context-sensitive link "
"to the GenWiki webtrees manual"
msgstr ""
"Перекрёстные ссылки на наборы данных Gedcom, редактор Markdown, контекстная "
"ссылка на руководство GenWiki по webtrees"

msgid "Home link - JSON with CSS rules seems to be invalid."
msgstr "Домашняя ссылка — JSON с правилами CSS недействителен."

msgid "Import registered routes"
msgstr "Импорт зарегистрированных маршрутов"

msgid "Cross-Reference Overview"
msgstr "Обзор перекрёстных ссылок"

msgid "Update the link index"
msgstr "Обновить индекс ссылок"

msgid "Update the UID index"
msgstr "Обновить индекс UID"

msgid "Rebuild the link index incrementally."
msgstr "Перестроить индекс ссылок поэтапно."

msgid "max records per run"
msgstr "максимальное количество записей за один запуск"

msgid "number of the tree to be scanned - all if not set"
msgstr "номер дерева для сканирования — все деревья, если не задано"

msgid "force a full rebuild"
msgstr "принудительно выполнить полную перестройку"

msgid "empty the index and exit"
msgstr "очистить индекс и завершить работу"

msgid "Rebuild the UID index incrementally."
msgstr "Перестроить индекс UID поэтапно."

msgid "The link index is out of date."
msgstr "Индекс ссылок устарел."

msgid "The UID index is out of date."
msgstr "Индекс UID устарел."

msgid ""
"List all records that contain cross-references (XREFs) or linkenhancer links."
msgstr ""
"Показать все записи, содержащие перекрёстные ссылки (XREF) или ссылки Link-"
"Enhancer."

msgid ""
"Limited mode: this database engine has no regex support - the table is "
"scanned live with a LIKE filter on every request, which can be slow on large "
"trees. The link index is not available on this engine."
msgstr ""
"Ограниченный режим: этот движок базы данных не поддерживает регулярные "
"выражения — таблица сканируется в реальном времени с фильтром LIKE при "
"каждом запросе, что может быть медленно для больших деревьев. Индекс ссылок "
"недоступен в этом движке."

#, php-format
msgid "Link index active: %1$s scanned records, last verified %2$s."
msgstr ""
"Индекс ссылок активен: просканировано записей: %1$s, последняя проверка: "
"%2$s."

msgid ""
"Live scan forced - the link index is bypassed for this view, which can be "
"slow on large trees."
msgstr ""
"Принудительное сканирование в реальном времени — индекс ссылок для этого "
"представления не используется, что может быть медленно для больших деревьев."

msgid ""
"No fresh link index - the table below scans the GEDCOM tables live, which "
"can be slow on large trees. Build the index with the CLI script (see "
"README.md, \"CLI scripts & maintenance\")."
msgstr ""
"Нет свежего индекса ссылок — таблицы GEDCOM ниже сканируются в реальном "
"времени, что может быть медленно для больших деревьев. Создайте индекс с "
"помощью CLI-скрипта (см. README.md, \"CLI-скрипты и обслуживание\")."

msgid ""
"Only broken targets: every matching record is loaded and its targets "
"resolved on the server, which can be slow on large trees. Combine with the "
"type filter to narrow the scan."
msgstr ""
"Только повреждённые цели: каждая подходящая запись загружается, а её цели "
"разрешаются на сервере, что может быть медленно для больших деревьев. "
"Используйте вместе с фильтром типов, чтобы сузить область сканирования."

msgid "referencing XREF"
msgstr "ссылающийся XREF"

msgid "Bypass the link index and scan the GEDCOM tables live"
msgstr "Обойти индекс ссылок и сканировать таблицы GEDCOM в реальном времени"

msgid "Force live scan"
msgstr "Принудительное сканирование в реальном времени"

msgid "Record types"
msgstr "Типы записей"

msgid "All types"
msgstr "Все типы"

msgid "All GEDCOM records"
msgstr "Все записи GEDCOM"

msgid "All Block records"
msgstr "Все записи блоков"

msgid "GEDCOM records"
msgstr "Записи GEDCOM"

msgid "links per class"
msgstr "ссылок на класс"

msgid "Only rows with a missing or wrong-type target are shown"
msgstr ""
"Показывать только строки с отсутствующей целью или целью неправильного типа"

msgid "Only broken targets"
msgstr "Только повреждённые цели"

msgid "The target type differs from the declaration"
msgstr "Тип цели отличается от объявления"

