<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;

/**
 * @var array<int, array{num: string, title_de: string, href: string, prefix?: string, prefix_tmpl?: string|null, prefix_arg?: string|null}> $items
 * @var array<string, string> $translations
 * @var string $generated
 * @var string $wiki_base
 */

$wiki_base = rtrim($wiki_base, '/');

// Präfix (z.B. "Kapitel 1 -") übersetzen: Template (prefix_tmpl) über die Weblate-Map,
// sonst rohes prefix (Deutsch / numerisch). Leer bei Einhängen ohne Wort-Präfix.
$prefix_out = static function (array $item) use ($translations): string {
    $raw  = rtrim($item['prefix'] ?? '');
    $tmpl = $item['prefix_tmpl'] ?? null;
    if ($tmpl === null) {
        return $raw;
    }
    return isset($translations[$tmpl])
        ? vsprintf($translations[$tmpl], [(string) ($item['prefix_arg'] ?? '')])
        : $raw;
};
?>
<div class="mw-parser-output">
<p><?= e(I18N::translate('As of %s', $generated)) ?></p>
<div class="wthbtoc">
<?php
$open = 0;
foreach ($items as $item):
    $depth  = substr_count($item['num'], '.');
    $title  = $translations[$item['title_de']] ?? $item['title_de'];
    $prefix = $prefix_out($item);
    $href   = $wiki_base . $item['href'];

    if ($depth === 0):
        while ($open > 0) {
            echo '</span></dd>';
            if ($open > 1) {
                echo '</dl>';
            }
            $open--;
        }
        // Pipe/Sonderzeichen aus SecNumber aus dem In-Page-Anchor entfernen (num kann "|" enthalten)
        $chapnum = preg_replace('/[^A-Za-z0-9]/', '', $item['num']) ?: 'sec';
        ?>
<h2><span class="mw-headline" id="ch<?= e($chapnum) ?>">
    <?php if ($prefix !== ''): ?><?= e($prefix) ?> <?php endif ?><a href="<?= e($href) ?>" title="<?= e($title) ?>"><?= e($title) ?></a>
</span></h2>
        <?php
    else:
        while ($open < $depth) {
            echo '<dl><dd><span class="item">';
            $open++;
        }
        while ($open > $depth) {
            echo '</span></dd>';
            if ($open > 1) {
                echo '</dl>';
            }
            $open--;
        }
        if ($open === $depth && $open > 1) {
            echo '</span>';
        }
        ?>
<span class="num"><?= e($prefix) ?> </span>
<a href="<?= e($href) ?>" title="<?= e($title) ?>"><?= e($title) ?></a>
        <?php
    endif;
endforeach;
while ($open > 0) {
    echo '</span></dd>';
    if ($open > 1) {
        echo '</dl>';
    }
    $open--;
}
?>
</div>
</div>
