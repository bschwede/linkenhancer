<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;

/**
 * @var array<int, array{num: string, title_de: string, href: string}> $items
 * @var array<string, string> $translations
 * @var string $generated
 * @var string $wiki_base
 */

$wiki_base = rtrim($wiki_base, '/');
?>
<div class="mw-parser-output">
<p><?= e(I18N::translate('As of %s', $generated)) ?></p>
<div class="wthbtoc">
<?php
$open = 0;
foreach ($items as $item):
    $depth = substr_count($item['num'], '.');
    $title = $translations[$item['title_de']] ?? $item['title_de'];
    $href  = $wiki_base . $item['href'];

    if ($depth === 0):
        while ($open > 0) {
            echo '</span></dd>';
            if ($open > 1) {
                echo '</dl>';
            }
            $open--;
        }
        $chapnum = explode('.', $item['num'])[0];
        ?>
<h2><span class="mw-headline" id="ch<?= e($chapnum) ?>">
    <?= e(I18N::translate('Chapter %s', $chapnum)) ?> -
    <a href="<?= e($href) ?>" title="<?= e($title) ?>"><?= e($title) ?></a>
</span></h2>
        <?php
    else:
        while ($open < $depth) {
            echo '<dl><dd><span class="item">';
            $open++;
        }
        while ($open > $depth) {
            echo '</span></dd>';
            if ($open > 1) {
                echo '</dl>';
            }
            $open--;
        }
        if ($open === $depth && $open > 1) {
            echo '</span>';
        }
        ?>
<span class="num"><?= e($item['num']) ?> </span>
<a href="<?= e($href) ?>" title="<?= e($title) ?>"><?= e($title) ?></a>
        <?php
    endif;
endforeach;
while ($open > 0) {
    echo '</span></dd>';
    if ($open > 1) {
        echo '</dl>';
    }
    $open--;
}
?>
</div>
</div>
