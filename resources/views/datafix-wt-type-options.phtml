<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;

/**
 * @var string $mode
 */

$texts = [
    'set'    => I18N::translate('Adds the correct type letter to wt= targets that have none (e.g. wt=@SOUR1@ → wt=s@SOUR1@).'),
    'repair' => I18N::translate('Corrects the type letter when it does not match the resolved target record (e.g. wt=i@SOUR1@ → wt=s@SOUR1@).'),
    'remove' => I18N::translate('Removes ALL type letters from wt= targets (e.g. wt=i@INDI1@ → wt=@INDI1@). The letters were originally only needed for JavaScript routing.'),
];
?>
<div class="row mb-3">
    <label class="col-sm-3 col-form-label"><?= e(I18N::translate('Mode')) ?></label>
    <div class="col-sm-9">
        <select class="form-select" name="wt_type_mode" id="wt-mode-select">
            <option value="set"    <?= $mode === 'set'    ? 'selected' : '' ?>><?= e(I18N::translate('Set — add missing type letters')) ?></option>
            <option value="repair" <?= $mode === 'repair' ? 'selected' : '' ?>><?= e(I18N::translate('Repair — correct wrong type letters')) ?></option>
            <option value="remove" <?= $mode === 'remove' ? 'selected' : '' ?>><?= e(I18N::translate('Remove — strip all type letters')) ?></option>
        </select>
    </div>
</div>

<div class="alert alert-info small mb-3" id="wt-mode-desc"><?= e($texts[$mode] ?? $texts['repair']) ?></div>

<script>
(function() {
    var select = document.getElementById('wt-mode-select');
    var desc   = document.getElementById('wt-mode-desc');
    if (!select || !desc) return;
    var texts = <?= json_encode($texts, JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    select.addEventListener('change', function() {
        desc.textContent = texts[this.value] || texts['repair'];
    });
})();
</script>
