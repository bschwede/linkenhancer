<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Tree;
use Schwendinger\Webtrees\Helpers\MoreI18N;
use Schwendinger\Webtrees\Module\LinkEnhancer\DataFix\FixHandlerInterface;
use Schwendinger\Webtrees\Module\LinkEnhancer\Http\RequestHandlers\DataFixBlocksAction;

/**
 * @var Tree                   $tree
 * @var array<string, string>  $params
 * @var array<string, FixHandlerInterface> $handlers
 * @var FixHandlerInterface    $active
 */

$active_id = $active->id();
?>

<div class="row mb-3">
    <label class="col-sm-3 col-form-label" for="fix_type"><?= e(MoreI18N::xlate('Fix type')) ?></label>
    <div class="col-sm-9">
        <select class="form-select" id="fix_type" name="fix_type">
            <?php foreach ($handlers as $id => $handler): ?>
                <option value="<?= e($id) ?>" <?= $id === $active_id ? 'selected' : '' ?>>
                    <?= e($handler->label()) ?>
                </option>
            <?php endforeach; ?>
        </select>
    </div>
</div>

<?= $active->optionsHtml($tree, $params) ?>

<?php if ($active_id === 'xref_uid_swap'): ?>
<div class="row mb-3">
    <label class="col-sm-3 col-form-label"><?= e(I18N::translate('Block modules')) ?></label>
    <div class="col-sm-9">
        <button type="button" class="btn btn-outline-primary btn-sm" id="btn-process-blocks"
            data-wt-href="<?= e(route(DataFixBlocksAction::class, ['tree' => $tree->name()])) ?>">
            <?= e(I18N::translate('Process block modules')) ?>
        </button>
        <span id="blocks-result" class="ms-2 small text-muted"></span>
    </div>
</div>
<script>
(function() {
    var btn = document.getElementById('btn-process-blocks');
    if (!btn) return;
    btn.addEventListener('click', function() {
        btn.disabled = true;
        var resultSpan = document.getElementById('blocks-result');
        resultSpan.textContent = '...';
        var form = btn.closest('form');
        var params = new URLSearchParams();
        if (form) {
            var direction = form.querySelector('[name="direction"]');
            if (direction) params.set('direction', direction.value);
        }
        var url = btn.getAttribute('data-wt-href') + (btn.getAttribute('data-wt-href').indexOf('?') !== -1 ? '&' : '?') + params.toString();
        fetch(url, {method: 'POST', credentials: 'same-origin'})
            .then(function(r) { return r.json(); })
            .then(function(data) {
                resultSpan.textContent = data.processed + ' ' + <?= e(json_encode(I18N::translate('checked'))) ?> + ', '
                    + data.changed + ' ' + <?= e(json_encode(I18N::translate('updated'))) ?> + ', '
                    + data.skipped + ' ' + <?= e(json_encode(I18N::translate('skipped'))) ?>;
            })
            .catch(function() { resultSpan.textContent = 'Error'; })
            .finally(function() { btn.disabled = false; });
    });
})();
</script>
<?php endif; ?>
