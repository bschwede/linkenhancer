$title_reset_access_level = e(I18N::translate('Reset list item access level overwrites - %s', I18N::translate('with configured access level')));

$link_params = is_array($links['resetlist_params'] ?? null) ? (array) $links['resetlist_params'] : null;
$link_reset_all = null;
$link_reset_access_level = null;
if (is_array($link_params)) {
    $link_reset_all = route('module', $link_params);
    $access_level = null;
    try {
        $access_level = (int) $prefs[LinkEnhancerModule::PREF_LINKSPP_OVERVIEW_ACCESS];
    } catch (Throwable $e) {}

    if (is_int($access_level)) {
        $link_params['access_level'] = $access_level;
        $link_reset_access_level = route('module', $link_params);
    }
}
