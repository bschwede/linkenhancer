<script>
    document.querySelectorAll('.confirm-action').forEach(link => {
        link.addEventListener('click', event => {
            const message = event.currentTarget.dataset.confirmMessage;
            if (!confirm("<?= I18N::translate('Confirmation Prompt - Do you really want to perform this action?') ?>" + "\n" + message)) {
                event.preventDefault();
                return;
            }
        });
    });
</script>        