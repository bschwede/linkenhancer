<?php

declare(strict_types=1);

use Fisharebest\Webtrees\GedcomRecord;
use Fisharebest\Webtrees\I18N;

/**
 * @var GedcomRecord $record
 * @var string       $outgoing_html
 * @var array        $incoming
 * @var int          $total_count
 */
?>
<div class="p-3" data-xref-count="<?= $total_count ?>">
    <?php if ($outgoing_html !== '') : ?>
        <h6 class="le-xref-section-title outbound mt-2"><?= I18N::translate('Outgoing references') ?></h6>
        <div class="le-xref-outgoing row"><?= $outgoing_html ?></div>
    <?php endif ?>

    <?php if ($incoming !== []) : ?>
        <h6 class="le-xref-section-title inbound mt-2"><?= I18N::translate('Incoming references') ?></h6>
        <table class="table table-sm le-xref-incoming-table">
            <thead>
                <tr>
                    <th><?= I18N::translate('Record') ?></th>
                    <th><?= I18N::translate('Type') ?></th>
                    <th class="text-end"><?= I18N::translate('Links') ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($incoming as $ref) : ?>
                    <tr>
                        <td>
                            <?php if (!empty($ref['tree_label'])) : ?>
                                <span class="text-muted small"><?= e($ref['tree_label']) ?>:</span>
                            <?php endif ?>
                            <?php if ($ref['url'] != ''): ?>
                            <a href="<?= e($ref['url']) ?>"><?= $ref['name'] ?></a>
                            <?php else: ?>
                            <?= $ref['name'] ?>
                            <?php endif; ?>
                        </td>
                        <td>
                            <?php if (($ref['source'] ?? 'gedcom') === 'block') : ?>
                                <span class="badge bg-secondary"><?= e($ref['rectype']) ?></span>
                            <?php else : ?>
                                <?= e($ref['rectype']) ?>
                            <?php endif ?>
                        </td>
                        <td class="text-end"><?= $ref['link_count'] ?></td>
                    </tr>
                <?php endforeach ?>
            </tbody>
        </table>
    <?php endif ?>

    <?php if ($outgoing_html === '' && $incoming === []) : ?>
        <p class="text-muted"><?= I18N::translate('No cross-references found.') ?></p>
    <?php endif ?>
</div>
