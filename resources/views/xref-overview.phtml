<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Http\RequestHandlers\ControlPanel;
use Fisharebest\Webtrees\Services\TreeService;
use Fisharebest\Webtrees\Registry;
use Fisharebest\Webtrees\Tree;
use Schwendinger\Webtrees\Module\LinkEnhancer\Services\XrefsService;

/**
 * @var string                  $title
 * @var string                  $sql
 * @var array                   $data
 */

$totalCount = count($data);
$treeService = Registry::container()->get(TreeService::class);
$tree = null;
?>

<?= view('components/breadcrumbs', [
    'links' => [
        route(ControlPanel::class) => I18N::translate('Control panel'),
        $title,
    ],
]) ?>

<h1 id="top"><?= e($title) ?></h1>

<p class="text-muted">
    <?= I18N::translate('This page lists all cross-references (XREFs) found in GEDCOM records and HTML blocks across all accessible trees.') ?>
</p>

<details class="mb-3">
    <summary class="text-muted"><?= I18N::translate('SQL') ?></summary>
    <pre><?= e($sql) ?></pre>
</details>

<div class="mb-3">
    <strong><?= $totalCount ?></strong>
    <?= $totalCount === 1 ? I18N::translate('XREF found') : I18N::translate('XREFs found') ?>.
</div>

<?php if ($totalCount === 0): ?>
    <div class="alert alert-info">
        <?= I18N::translate('No XREFs found matching the current filter criteria.') ?>
    </div>
<?php else: ?>
<div class="table-responsive">
    <table class="table table-striped table-sm table-hover fs-6">
        <thead>
            <tr>
                <th>#</th>
                <th><?= I18N::translate('xref') ?></th>
                <th><?= I18N::translate('file') ?></th>
                <th><?= I18N::translate('type') ?></th>
                <th><?= I18N::translate('gedcom') ?></th>
                <th><?= I18N::translate('count') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php $i = 0; ?>
            <?php foreach ($data as $row):
                $xref = $row['xref'];
                $file = (int) $row['file'];
                if (!($tree instanceof Tree && $tree->id() === $file)) {
                    try {
                        $tree = $treeService->find($file);
                    } catch (DomainException) {
                        // Orphaned row - the tree no longer exists, skip it.
                        continue;
                    }
                }
                $record = Registry::gedcomRecordFactory()->make($xref, $tree, $row['gedcom']);
                $displayname = $record->fullName();

            ?>
                <?php $i++; ?>
                <tr>
                    <td><?= $i ?></td>
                    <td>
                        <a href="<?= $record->url() ?>"><?= e($xref) ?></a>
                        <p class="text-muted"><?= e($tree->name()) ?></p>
                        
                    </td>
                    <td><?= e($row['file']) ?></td>
                    <td><?= e($row['type']) ?></td>
                    <td>
                        <a href="<?= $record->url() ?>"><?= e($displayname) ?></a>
<?php $inventory = XrefsService::classifyRecordLinks($record); ?>
                        <?php if ($inventory['entries'] !== []): ?>
                        <ol>
                            <?php foreach ($inventory['entries'] as $link): ?>
                                <li><?= e($link['path'] !== 'NOTE' ? $link['path'] . ': ' : '') ?><pre><?= e($link['snippet']) ?></pre></li>
                            <?php endforeach; ?>
                        </ol>
                        <?php endif; ?>
                    </td>
                    <td>
                        le: <?= $inventory['counts']['le'] ?> / le-pic: <?= $inventory['counts']['lepic'] ?> / enhanced: <?= $inventory['counts']['enhanced'] ?> / classic: <?= $inventory['counts']['classic'] ?> / other: <?= $inventory['counts']['other'] ?>
                    </td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>
</div>
<?php endif; ?>
