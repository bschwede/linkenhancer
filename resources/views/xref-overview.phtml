<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Http\RequestHandlers\ControlPanel;
use Fisharebest\Webtrees\Services\TreeService;
use Fisharebest\Webtrees\Registry;
use Fisharebest\Webtrees\Tree;
use Schwendinger\Webtrees\Module\LinkEnhancer\Services\XrefsService;
use Schwendinger\Webtrees\Module\LinkEnhancer\Services\TextTagCollector;

/**
 * @var string                  $title
 * @var string                  $sql
 * @var array                   $data
 */

$totalCount = count($data);
$treeService = Registry::container()->get(TreeService::class);
$tree = null;
$xrefService = new XrefsService();
?>

<?= view('components/breadcrumbs', [
    'links' => [
        route(ControlPanel::class) => I18N::translate('Control panel'),
        $title,
    ],
]) ?>

<h1 id="top"><?= e($title) ?></h1>

<p class="text-muted">
    <?= I18N::translate('This page lists all cross-references (XREFs) found in GEDCOM records and HTML blocks across all accessible trees.') ?>
</p>


<div class="mb-3">
    <strong><?= $totalCount ?></strong>
    <?= $totalCount === 1 ? I18N::translate('XREF found') : I18N::translate('XREFs found') ?>.
</div>

<?php if ($totalCount === 0): ?>
    <div class="alert alert-info">
        <?= I18N::translate('No XREFs found matching the current filter criteria.') ?>
    </div>
<?php else: ?>
<div class="table-responsive">
    <table class="table table-striped table-sm table-hover fs-6">
        <thead>
            <tr>
                <th>#</th>
                <th><?= I18N::translate('xref') ?></th>
                <th><?= I18N::translate('file') ?></th>
                <th><?= I18N::translate('type') ?></th>
                <th><?= I18N::translate('gedcom') ?></th>
                <th><?= I18N::translate('count') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php $i = 0; ?>
            <?php foreach ($data as $row):
                $xref = $row['xref'];
                $file = (int) $row['file'];
                $tree = $tree instanceof Tree && $tree->id() === $file ? $tree : $treeService->find($file);
                $record = Registry::gedcomRecordFactory()->make($xref, $tree, $row['gedcom']);
                $displayname = $record->fullName();
            
            ?>
                <?php $i++; ?>
                <tr>
                    <td><?= $i ?></td>
                    <td>
                        <a href="<?= $record->url() ?>"><?= e($xref) ?></a>
                        <p class="text-muted"><?= e($tree->name()) ?></p>
                        
                    </td>
                    <td><?= e($row['file']) ?></td>
                    <td><?= e($row['type']) ?></td>
                    <td>
                        <a href="<?= $record->url() ?>"><?= $displayname ?></a>
                        <ol>
<?php
                $cnt_le = 0;
                $cnt_lepic = 0;
                $cnt_classicxref = 0;
                $cnt_other = 0;
                foreach (TextTagCollector::collectForRecord($record) as $entry) {
                    $links = preg_match_all('/(?:(!?\[)[^\]]+\]\(#@[^\)]+\)|[^@]{0,10}@([A-Za-z0-9:_.-]{1,20})@[^@]{0,10}|.{0,10}(\]\(#@).{0,10})/', $entry['value'], $m);
                    //$links = preg_match_all('/(?:(!?\[)[^\]]+?\]\(#@[^\)]+?\)|[^@]{0,10}@([A-Za-z0-9:_.-]{1,20})@[^@]{0,10})/', $entry['value'], $m);
                      
                    if ($links > 0) {
                        for ($idx = 0; $idx < $links; $idx++) {
                            switch ($m[1][$idx]) {
                                case '![':
                                    $cnt_lepic++;
                                    break;
                                case '[':
                                    $cnt_le++;
                                    break;
                                case '](#@':
                                    $cnt_other++;
                                    break;
                                default:
                                    $cnt_classicxref++;
                            }
    /*
                                if ($m[1][$idx] === '') {
                                    if (substr($m[0][$idx], 0, 1) === '[') { // le xref
                                        $cnt_le++;
                                    } elseif (substr($m[0][$idx], 0, 2) === '![') { // le pic
                                        $cnt_lepic++;
                                    } else {
                                        $cnt_other++;
                                    }
                                } elseif ($m[1][$idx] === '](#@') { // other - le syntax but not valid
                                    $cnt_other++;
                                } else { //classic xref
                                    $cnt_classicxref++;
                                }
    */
                            echo('<li>' . ($entry['path'] !== 'NOTE' ? $entry['path'] . ': ' : '') . '<pre>' . e($m[0][$idx]) . '</pre></li>');
                        }
                    }
                    
                }
?>
                        </ol>
                    </td>
                    <td>
                        le: <?= $cnt_le ?> / le-pic: <?= $cnt_lepic ?> / classic: <?= $cnt_classicxref ?> / other: <?= $cnt_other ?>
                    </td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>
</div>
<?php endif; ?>
