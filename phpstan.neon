parameters:
    level: 6
    paths:
        - src/
    excludePaths:
        - src/LinkEnhancerModuleExt.php
    bootstrapFiles:
        - ../../vendor/autoload.php
        - phpstan-bootstrap.php
    scanDirectories:
        - ../../app/
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - '#Call to static method from\(\) on an unknown class Fisharebest\\Webtrees\\Enums\\AccessLevel#'
        - '#Parameter \#1 \$identifier of static method Fisharebest\\Webtrees\\DB::prefix\(\) expects non-empty-string, '''' given#'
    parallel:
        maximumNumberOfProcesses: 0
