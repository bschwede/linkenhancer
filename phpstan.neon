parameters:
    level: 6
    paths:
        - src/
    excludePaths:
        - src/LinkEnhancerModuleExt.php
    bootstrapFiles:
        - ../../vendor/autoload.php
        - phpstan-bootstrap.php
    scanDirectories:
        - ../../app/
    ignoreErrors:
        - '#Call to method .* on mixed#'
    parallel:
        maximumNumberOfProcesses: 0
